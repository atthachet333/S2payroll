# =============================================================================
# S2A Payroll — FRONTEND production environment template
#
# Copy to `.env.production` (or `.env`) before building and replace the
# placeholder. Placeholders only; safe to commit.
#
# IMPORTANT: every VITE_* variable is compiled into the public JavaScript
# bundle and is visible to anyone who loads the page. Never put a database
# URL, an API key, a JWT secret or any Google credential here.
# =============================================================================

# Public URL of the payroll API. Must be reachable from the user's BROWSER,
# not from the server. Behind a reverse proxy this is normally the same origin
# as the site itself.
#
#   Same-origin behind a proxy:  VITE_API_URL=https://payroll.<YOUR_DOMAIN>
#   Separate API hostname:       VITE_API_URL=https://payroll-api.<YOUR_DOMAIN>
#
# Whatever is set here must appear in the backend's CORS_ORIGIN allow-list.
# Vite inlines this at BUILD time — changing it later requires a rebuild.
VITE_API_URL=https://payroll.<YOUR_DOMAIN>
