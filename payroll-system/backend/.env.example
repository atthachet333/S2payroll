# ---- Server ----
PORT=2234
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ---- Database (MariaDB) ----
# Dedicated payroll database on the LAN MariaDB server 192.168.2.135:3306.
# NEVER point this at the ERP databases (s2a_erp_main / s2a_erp) -
# scripts/db-guard.ts blocks every migration and seed if you do.
DATABASE_URL="mysql://s2apayroll:REPLACE_WITH_DB_PASSWORD@192.168.2.135:3306/s2apayroll"

# ---- Auth ----
JWT_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:2233

# ---- Rate limiting ----
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ---- Google Sheets (service account) ----
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_ATTENDANCE_SHEET_NAME=Attendance
# Optional explicit A1 override. Leave blank to derive <tab>!A:Z from the name above.
GOOGLE_SHEET_RANGE=

# ---- Seed bootstrap admin ----
SEED_ADMIN_EMAIL=admin@payroll.local
SEED_ADMIN_PASSWORD=Admin@12345
