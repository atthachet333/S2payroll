{
  "name": "payroll-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "npm run db:check && prisma migrate dev",
    "prisma:deploy": "npm run db:check && prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "npm run db:check && tsx prisma/seed.ts",
    "db:check": "tsx scripts/db-guard.ts",
    "cleanup:test-payroll": "tsx scripts/cleanup-test-payroll.ts",
    "admin:force-password-change": "tsx scripts/force-password-change.ts",
    "db:apply-executive-exemptions": "npm run db:check && tsx scripts/apply-executive-exemptions.ts",
    "db:apply-payroll-config-schema": "npm run db:check && tsx scripts/apply-payroll-config-schema.ts",
    "attendance:policy-preview": "npm run db:check && tsx scripts/apply-attendance-policy.ts",
    "attendance:policy-apply": "npm run db:check && tsx scripts/apply-attendance-policy.ts --apply"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@expo-google-fonts/sarabun": "^0.4.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fontsource/sarabun": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.4.1",
    "archiver": "^8.0.0",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "googleapis": "^144.0.0",
    "pdfkit": "^0.20.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pngjs": "^6.0.5",
    "pdfjs-dist": "^6.2.108",
    "pino-pretty": "^13.1.3",
    "pngjs": "^7.0.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
