# =============================================================================
# S2A Payroll — BACKEND production environment template
#
# Copy to `.env` on the production host and replace every <PLACEHOLDER>.
# This file contains placeholders only and is safe to commit.
# The real `.env` is git-ignored and must never be committed.
#
# The server validates this configuration at startup and REFUSES TO START in
# production if secrets are placeholders, CORS is wide open, or a known seed
# password is still in use.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=2234
# Bind to loopback and let the reverse proxy / Cloudflare Tunnel be the only
# public listener. Use 0.0.0.0 only if the host itself is firewalled.
HOST=127.0.0.1
LOG_LEVEL=info

# ---- Database ---------------------------------------------------------------
# MUST end in /s2apayroll. scripts/db-guard.ts blocks every migration and seed
# if this points anywhere else, and s2a_erp_main is explicitly forbidden.
DATABASE_URL="mysql://s2apayroll:<DB_PASSWORD>@192.168.2.135:3306/s2apayroll"

# ---- Auth -------------------------------------------------------------------
# Generate each independently, 48 random bytes, and never reuse one for the other:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<48_RANDOM_BYTES_HEX>
JWT_REFRESH_SECRET=<A_DIFFERENT_48_RANDOM_BYTES_HEX>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- CORS -------------------------------------------------------------------
# Comma-separated allow-list of exact origins. Never "*".
# In production this must be the real https origin, not localhost.
CORS_ORIGIN=https://payroll.<YOUR_DOMAIN>
# Alias accepted by some deployment tooling; keep both in sync if you set it.
CORS_ORIGINS=https://payroll.<YOUR_DOMAIN>

# Public base URL of the application, used in operational messages.
APP_BASE_URL=https://payroll.<YOUR_DOMAIN>

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ---- Google Sheets (attendance source, READ-ONLY) ---------------------------
# The service account needs VIEWER access to the sheet and nothing more.
# The payroll system never writes back to the source spreadsheet.
# Leave blank to run without attendance sync — payroll still operates fully
# from attendance already imported into the database.
GOOGLE_PROJECT_ID=<GCP_PROJECT_ID>
GOOGLE_CLIENT_EMAIL=<SERVICE_ACCOUNT>@<GCP_PROJECT_ID>.iam.gserviceaccount.com
# Single line, literal \n escapes, wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<KEY_BODY>\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=<SPREADSHEET_ID_FROM_THE_SHEET_URL>
# Tab name holding attendance. Columns are matched by header name (Thai or
# English), so only the tab and range matter here.
GOOGLE_ATTENDANCE_SHEET_NAME=Attendance
GOOGLE_SHEET_RANGE=

# ---- Bootstrap admin --------------------------------------------------------
# Used ONLY when creating the very first administrator on an empty database.
# The seed never resets an existing account's password.
# Must NOT be a known default such as Admin@12345 — startup validation rejects it.
SEED_ADMIN_EMAIL=<ADMIN_EMAIL>
SEED_ADMIN_PASSWORD=<STRONG_UNIQUE_BOOTSTRAP_PASSWORD>
